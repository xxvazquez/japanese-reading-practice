  "grammar": [
    {
      "pattern": "〜つもりです",
      "explanation": "Expresses a plan or intention, attached to a verb's dictionary form, as in 見るつもりです (\"[I] plan to watch\")."
    },
    {
      "pattern": "〜たいです",
      "explanation": "The desiderative form expresses \"want to ~\", attached to a verb's stem; it conjugates like an i-adjective, as in 食べたいです (\"[I] want to eat\")."
    },
    {
      "pattern": "〜ながら",
      "explanation": "Attached to a verb's stem, expresses doing two actions at the same time, as in 散歩しながら聞きます (\"listen while walking\")."
    },
    {
      "pattern": "〜たほうがいいです",
