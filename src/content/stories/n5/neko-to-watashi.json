  "grammar": [
    {
      "pattern": "い-adjective + くて",
      "explanation": "The te-form of an i-adjective (白い → 白くて) links it to another description in the same sentence, as in 白くて、小さいです (\"white and small\")."
    },
    {
      "pattern": "〜がいます",
      "explanation": "います marks the existence of an animate being such as a person or animal; あります is used instead for inanimate things."
    },
    {
      "pattern": "〜が好き/大好きです",
      "explanation": "With feeling adjectives like 好き (\"like\") and 大好き (\"love\"), が marks the thing being liked, not を, as in モモが大好きです (\"[I] love Momo\")."
    },
    {
      "pattern": "な-adjective + です",
      "explanation": "な-adjectives such as 大好き attach directly to です as the sentence predicate; な only appears when the adjective comes before a noun (大好きな猫)."
    }
  ]
