  "grammar": [
    {
      "pattern": "〜ています",
      "explanation": "Te-form + います describes an ongoing state or habitual situation, as in 住んでいます (\"[I] live / am living\")."
    },
    {
      "pattern": "て-form for connecting actions",
      "explanation": "Joining a verb's te-form with a comma links two actions in sequence within one sentence, as in 洗って、磨きます (\"[I] wash and then brush\")."
    },
    {
      "pattern": "time + に",
      "explanation": "に after a specific time expression marks when an action happens, as in 七時に (\"at seven o'clock\")."
    },
    {
      "pattern": "〜を + verb",
      "explanation": "を marks the direct object of a transitive verb, as in 朝ご飯を食べます (\"[I] eat breakfast\")."
    },
    {
      "pattern": "〜で (place of action)",
      "explanation": "で marks the place or context where an action takes place, as in 仕事で (\"at work\")."
    },
    {
      "pattern": "〜が + intransitive verb",
      "explanation": "が marks the subject of an intransitive verb such as 終わります, as in 仕事が終わります (\"work finishes\")."
    },
    {
      "pattern": "〜ごろ",
      "explanation": "ごろ attaches to a time expression to mean \"around/about,\" as in 十一時ごろ (\"around eleven o'clock\")."
    }
  ]
